<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.taitungsun.dictbridge"
    android:versionCode="7" android:versionName="1.4.1">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Granted once over adb, so the app can switch its accessibility service back on
         after the Boox NaviBall toggle drops it from the list. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <queries><package android:name="com.onyx.dict" /></queries>
    <application android:label="Dictionary" android:icon="@drawable/ic_launcher" android:allowBackup="false">
        <!-- Economist's "Define" (overflow) and "Translate" (main bar) buttons send
             ACTION_DEFINE / ACTION_TRANSLATE + EXTRA_TEXT. Define opens the dictionary
             popup; Translate shows a Gemini translation (TranslateActivity). -->
        <activity android:name=".BridgeActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.DEFINE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Economist targets SDK 30+ and only "sees" apps matching its <queries>;
                 it queries SEND text/plain, so this filter makes us visible to it.
                 Also gives a "Dictionary" share target. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Invisible first stop for Translate: keeps the article window readable by the
             accessibility service, then opens TranslateActivity. -->
        <activity android:name=".TranslateEntry" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.TRANSLATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".TranslateActivity" android:exported="false"
            android:label="Translate" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".ParagraphService" android:exported="false"
            android:label="Dict Bridge paragraphs"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/paragraph_service" />
        </service>
        <!-- Launcher icon: without one, Boox never lists the app in its auto-freeze
             settings and re-freezes it on every boot. -->
        <activity android:name=".StatusActivity" android:label="Dict Bridge"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
